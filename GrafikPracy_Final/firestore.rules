rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validRole(value) {
      return value == 'admin' || value == 'employee';
    }

    function validPersonKey(value) {
      return value == 'P' || value == 'M' || value == 'L';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Public registration creates only a minimal employee profile.
      // Role escalation is impossible through this path.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','role','createdAt'])
        && request.resource.data.role == 'employee'
        && request.resource.data.email is string;

      // A normal user may change only the person assignment used by the app.
      // System-managed fields and Authentication data remain protected.
      allow update: if signedIn()
        && request.auth.uid == uid
        && !isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personKey'])
        && validPersonKey(request.resource.data.personKey)
        && request.resource.data.role == resource.data.role;

      // Administrators use Cloud Functions for profile management. They may not
      // directly modify their own profile, which prevents bypassing the role guard.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.uid == uid
        && validRole(request.resource.data.role)
        && validPersonKey(request.resource.data.personKey);

      // Direct client deletion is never allowed. Account deletion goes through
      // the trusted Cloud Function, which also blocks deleting the caller.
      allow delete: if false;
    }

    // Public read is intentional: guest mode shows the current and next week.
    // Only the schedule document is public; users, proposals and audit remain protected.
    match /schedules/main {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if isAdmin() || (signedIn() && resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /chatMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /whatsappReports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }

    match /locationConfig/main {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vehicleTracking/{vehicleId} {
      allow read: if signedIn();

      // Employees may create only a document that explicitly belongs to them.
      // The document id remains a business-level vehicle identifier; assignment
      // to a vehicle must still be enforced by the application/business layer.
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180);

      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180);

      allow delete: if isAdmin();

      match /locations/{locationId} {
        allow read: if signedIn();

        allow create: if isAdmin()
          || (signedIn()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.latitude is number
            && request.resource.data.longitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180);

        allow update: if isAdmin()
          || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.latitude is number
            && request.resource.data.longitude is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180);

        allow delete: if isAdmin();
      }
    }

    match /audit/{entryId} {
      // Audit records are trusted records. Clients cannot forge them.
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
