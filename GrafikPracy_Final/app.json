{
  "expo": {
    "name": "Grafik Pracy",
    "slug": "grafikpracyapp",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./icon-512.png",
    "web": {
      "output": "single"
    },
    "android": {
      "package": "pl.grafikpracy.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./icon-512.png",
        "backgroundColor": "#11151c"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a1bf7cf9-1bfd-4bd0-8392-e9c3266ce9b6"
      }
    },
    "owner": "kafel17",
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Grafik Pracy używa lokalizacji służbowego telefonu, aby pokazywać auto na żywo i automatycznie dobierać raporty.",
          "locationAlwaysAndWhenInUsePermission": "Grafik Pracy używa lokalizacji służbowego telefonu w tle, aby pokazywać auto na żywo i automatycznie dobierać raporty.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "GrafikTeraz",
              "label": "Grafik Pracy • Teraz",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Aktualna zmiana, pracownik i odliczanie.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "GrafikAuto",
              "label": "Grafik Pracy • Auto",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Status auta i lokalizacji GPS.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "GrafikRaport",
              "label": "Grafik Pracy • Raport",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "Ostatni raport WhatsApp i naliczany czas.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}